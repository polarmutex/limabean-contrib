; Example A from the README: two +10 postings vs one -20 posting.
; The -20 does not pair with either +10, so nothing matches.
plugin "beancount-reds-plugins.zerosum.zerosum" "{:zerosum-accounts {\"Assets:ZSA:Transfers\" [\"Assets:ZSA-Matched:Transfers\" 30]}}"

2005-01-01 open Assets:Bank USD
2005-01-01 open Assets:TB-Trading USD
2005-01-01 open Assets:ZSA:Transfers USD
2005-01-01 open Assets:ZSA-Matched:Transfers USD

2005-01-01 * "Transfer"
  Assets:Bank             -20 USD
  Assets:ZSA:Transfers     10 USD
  Assets:ZSA:Transfers     10 USD

2005-01-03 * "Transfer"
  Assets:TB-Trading        20 USD
  Assets:ZSA:Transfers    -20 USD
